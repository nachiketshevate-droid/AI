maze = [
    [0, 1, 0, 0],
    [0, 0, 0, 1],
    [1, 0, 1, 0],
    [0, 0, 0, 0]
]

rows, cols = len(maze), len(maze[0])
visited = set()


def dfs(x, y):
    if (x < 0 or y < 0 or x >= rows or y >= cols
            or maze[x][y] == 1 or (x, y) in visited):
        return False

    print("Visited:", (x, y))

    if (x, y) == (3, 3):
        print("\nGoal Reached!")
        return True

    visited.add((x, y))

    return (dfs(x + 1, y) or dfs(x - 1, y)
            or dfs(x, y + 1) or dfs(x, y - 1))


print("Starting DFS from (0, 0)\n")
dfs(0, 0)
